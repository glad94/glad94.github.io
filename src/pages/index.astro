---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout 
  title="Home" 
  description="Hi there, I’m Gerald. Welcome to my web page where I write about sports analytics and other projects."
>
  <div class="hero">
    <div class="hero-content">
      <h1 class="hero-title">Hi there, I’m <span class="highlight">Gerald</span>.</h1>
      <p class="hero-subtitle">
        These days I'm a weather-focused data engineer in the renewable energy space.
      </p>
      <div class="hero-body">
        <p> 
          This site was born whilst I was starting to dip my feet into the online football/tennis analytics scene back in the early days of COVID.
          Hence, most of my stuff here has been (and should continue to be) on that topic, but I might occasionally write about other random things too. 
          Hope you enjoy your visit here!
        </p>
      </div>
      <div class="hero-actions">
        <a href="/blog/" class="btn btn-primary">Read my blog</a>
        <a href="https://github.com/glad94" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">View my GitHub</a>
      </div>
    </div>
    <div class="hero-image-container">
      <img src="/img/me.png" alt="Gerald Lim profile picture" class="profile-img" />
    </div>
  </div>

  <section class="latest-section">
    <div class="section-header">
      <h2>Latest Posts</h2>
      <a href="/blog/" class="view-all">View all &rarr;</a>
    </div>
    
    <div class="post-grid">
      {latestPosts.map(post => (
        <BlogCard 
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          category={post.data.category}
          slug={post.slug}
          image={post.data.image}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-8);
    margin-bottom: var(--space-16);
    padding-top: var(--space-8);
  }

  @media (min-width: 640px) {
    .hero {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .hero-content {
    flex: 1;
  }

  .hero-title {
    font-size: 3rem;
    margin-top: 0;
    margin-bottom: var(--space-4);
    line-height: 1.1;
  }

  .highlight {
    color: var(--color-accent-primary);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    font-weight: 500;
    margin-bottom: var(--space-4);
  }

  .hero-body {
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .hero-image-container {
    flex-shrink: 0;
    width: 200px;
    height: 200px;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .hero-image-container {
      width: 240px;
      height: 240px;
      margin: 0;
    }
  }

  .profile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    margin: 0;
    border: 4px solid var(--color-surface);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.6em 1.2em;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary {
    background-color: var(--color-accent-primary);
    color: #fff;
  }

  .btn-primary:hover {
    background-color: var(--color-text);
    color: var(--color-bg);
    text-decoration: none;
  }

  /* Specific rule to make text legible inside the dark theme btn-primary hover */
  :global([data-theme='dark']) .btn-primary {
    color: var(--color-bg);
  }
  :global([data-theme='dark']) .btn-primary:hover {
    background-color: var(--color-text);
    color: var(--color-bg);
  }

  .btn-secondary {
    background-color: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    border-color: var(--color-accent-secondary);
    color: var(--color-accent-secondary);
    text-decoration: none;
  }

  .latest-section {
    margin-top: var(--space-12);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-2);
  }

  .section-header h2 {
    margin: 0;
  }

  .view-all {
    font-weight: 500;
  }

  .post-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .post-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
